# DATABASE CONFIGURATION
DB_NAME=easyerpshop
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# REDIS CONFIGURATION
REDIS_PASSWORD=your_redis_password

# APPLICATION SECURITY
JWT_SECRET=your_jwt_secret_at_least_32_characters
ENCRYPTION_KEY=your_encryption_key

# SPRING PROFILE
SPRING_PROFILES_ACTIVE=production
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# KAFKA
KAFKA_BROKER=kafka:9092

# SERVER CONFIGURATION
SERVER_PORT=9090
SERVER_PORT_HOST=9091
FRONTEND_PORT=80

# TIMEZONE
TZ=UTC

# STORAGE
STORAGE_ACTIVE=LOCAL
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_PUBLIC_URL=http://localhost:9091

# DATABASE CONNECTION
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/easyerpshop
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# REDIS CONNECTION
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_redis_password

# KAFKA CONNECTION
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# INITIALIZATION DATABASE
INIT_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres
INIT_DATASOURCE_USERNAME=your_database_username
INIT_DATASOURCE_PASSWORD=your_database_password

# FRONTEND
VUE_APP_API_URL=http://localhost:9091

# ENCRYPTION
ENCRYPTION_SECRET_KEY=your_encryption_secret_key

# AI PROVIDERS (OPTIONAL)
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# PAYMENT GATEWAY (OPTIONAL)
RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# EMAIL PROVIDER (OPTIONAL)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=[noreply@example.com](mailto:noreply@example.com)