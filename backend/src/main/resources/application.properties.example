# DATABASE (PostgreSQL)
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/easyerpshop}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:YOUR_DB_PASSWORD}

spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# REDIS
spring.redis.host=${SPRING_REDIS_HOST:localhost}
spring.redis.port=${SPRING_REDIS_PORT:6379}
spring.redis.password=${SPRING_REDIS_PASSWORD:YOUR_REDIS_PASSWORD}

# KAFKA
spring.kafka.bootstrap-servers=${SPRING_KAFKA_BOOTSTRAP_SERVERS:localhost:9092}

# Kafka Topics
kafka.topics.verification-email=verification-email
kafka.topics.import-job=import-job
kafka.topics.export-job=export-job
kafka.consumer-groups.verification=verification-group
kafka.consumer-groups.import=import-group
kafka.consumer-groups.export=export-group

# JWT
jwt.secret=${JWT_SECRET:ChangeThisJWTSecretInProduction123!}
jwt.expirationMs=${JWT_EXPIRATION_MS:86400000}

# SERVER
server.port=${SERVER_PORT:9090}

# FILE STORAGE
storage.active=${STORAGE_ACTIVE:LOCAL}
storage.local.base-path=${STORAGE_LOCAL_PATH:./uploads}
storage.local.public-url-prefix=${STORAGE_PUBLIC_URL:http://localhost:9090}

# SPRING PROFILE
spring.profiles.active=${SPRING_PROFILES_ACTIVE:local}

# INIT / ADMIN DATABASE
init.datasource.url=${INIT_DATASOURCE_URL:jdbc:postgresql://localhost:5432/postgres}
init.datasource.username=${INIT_DATASOURCE_USERNAME:postgres}
init.datasource.password=${INIT_DATASOURCE_PASSWORD:YOUR_INIT_DB_PASSWORD}

management.endpoint.health.show-details=always

# Email Service Configuration
email.service.async-thread-pool=10
email.service.max-retry-attempts=3
email.service.retry-delay-ms=1000

app.encryption.secret-key=${ENCRYPTION_SECRET_KEY:YOUR_ENCRYPTION_SECRET_KEY}

# AI Providers
ai.providers.openai.api-key=${OPENAI_API_KEY:YOUR_OPENAI_API_KEY}
ai.providers.openai.base-url=https://api.openai.com
ai.providers.openai.default-model=gpt-4

ai.providers.deepseek.api-key=${DEEPSEEK_API_KEY:YOUR_DEEPSEEK_API_KEY}
ai.providers.deepseek.base-url=https://api.deepseek.com
ai.providers.deepseek.default-model=deepseek-chat

ai.providers.claude.api-key=${ANTHROPIC_API_KEY:YOUR_ANTHROPIC_API_KEY}
ai.providers.claude.base-url=https://api.anthropic.com
ai.providers.claude.default-model=claude-3-opus-20240229

ai.providers.ollama.base-url=http://localhost:11434
ai.providers.ollama.default-model=llama2

ai.retry.max-attempts=3
ai.retry.backoff-delay-ms=1000

ai.encryption.secret=${AI_ENCRYPTION_SECRET:YOUR_AI_ENCRYPTION_SECRET_32_CHARS}
ai.encryption.salt=${AI_ENCRYPTION_SALT:YOUR_AI_ENCRYPTION_SALT_16_CHARS}

exchange.provider.name=FRANKFURTER
exchange.provider.frankfurter.url=https://api.frankfurter.app