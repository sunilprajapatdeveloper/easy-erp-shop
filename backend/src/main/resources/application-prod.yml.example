storage:
  active: s3
  max-file-size: 50MB

  s3:
    enabled: true
    bucket: ${STORAGE_S3_BUCKET:YOUR_S3_BUCKET}
    region: ${STORAGE_S3_REGION:YOUR_S3_REGION}
    access-key: ${STORAGE_S3_ACCESS_KEY:YOUR_S3_ACCESS_KEY}
    secret-key: ${STORAGE_S3_SECRET_KEY:YOUR_S3_SECRET_KEY}
    cdn-url: ${STORAGE_S3_CDN_URL:YOUR_S3_CDN_URL}

  thumbnail:
    enabled: true
    width: 400
    height: 400
    quality: 0.8

# ===============================
# KAFKA
# ===============================
spring:
  kafka:
    bootstrap-servers: ${KAFKA_BROKER:kafka:9092}
    consumer:
      group-id: ${KAFKA_CONSUMER_GROUP:verification-group}
      auto-offset-reset: earliest
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      properties:
        spring.json.trusted.packages: "*"
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
    listener:
      missing-topics-fatal: false

# Kafka Topics
kafka:
  topics:
    verification-email: ${KAFKA_TOPIC_VERIFICATION_EMAIL:verification-email}
    import-job: ${KAFKA_TOPIC_IMPORT_JOB:import-job}
    export-job: ${KAFKA_TOPIC_EXPORT_JOB:export-job}
  consumer-groups:
    verification: ${KAFKA_CONSUMER_GROUP_VERIFICATION:verification-group}
    import: ${KAFKA_CONSUMER_GROUP_IMPORT:import-group}
    export: ${KAFKA_CONSUMER_GROUP_EXPORT:export-group}